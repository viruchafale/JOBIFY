# Auth Service Environment Variables
# Copy to .env and fill in real values. Never commit the filled .env file.

# Server
PORT=5002
NODE_ENV=development

# PostgreSQL (Neon)
DB_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT / Session
# Must be a long random secret, e.g.: openssl rand -hex 64
SECRET_KEY=replace-with-a-long-random-secret

# Redis (session store, password-reset tokens, rate-limit counters)
REDIS_URL=redis://localhost:6379

# URL of the utils service (internal; never expose to frontend)
UPLOAD_SERVICE=http://localhost:5005

# Shared secret that identifies trusted internal service calls
# Must match INTERNAL_SERVICE_KEY in the utils service
# e.g.: openssl rand -hex 32
INTERNAL_SERVICE_KEY=replace-with-shared-internal-secret

# Kafka (email delivery)
KAFKA_BROKER=localhost:9092

# Frontend origin(s) allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Public frontend URL used to build password-reset links
FRONTEND_URL=http://localhost:3000
