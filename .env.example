# Jobify 2.0 Environment Configuration

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jobify
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobify

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth & Sessions
# Must be a long random secret, e.g.: openssl rand -hex 64. This is the
# only variable name the code actually reads (services/*/src/**/auth.ts,
# session.ts) — it is shared across auth/user/job/utils for signing and
# verifying the same JWTs.
SECRET_KEY=replace_with_a_long_random_production_secret

# Origin(s) the Gateway and every backend service will accept
# cross-origin requests from (comma-separated). Must match wherever the
# frontend is actually reachable from the browser.
CORS_ORIGINS=http://localhost:3000

# Public frontend URL used by auth-service to build password-reset links.
FRONTEND_URL=http://localhost:3000

# Cloudinary (User & Job attachments)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Utils & Email
GEMINI_API_KEY=your_gemini_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# Gateway & Ports
GATEWAY_PORT=5000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:5000
