# Jobify 2.0 Environment Configuration

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jobify
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobify

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth & Sessions
JWT_SECRET=jobify_super_secret_jwt_key_2026
SESSION_SECRET=jobify_super_secret_session_key_2026
CLIENT_URL=http://localhost:3000

# Cloudinary (User & Job attachments)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Utils & Email
GEMINI_API_KEY=your_gemini_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# Gateway & Ports
GATEWAY_PORT=5000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:5000
