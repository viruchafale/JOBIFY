# Job Service Environment Variables
# Copy to .env and fill in real values. Never commit the filled .env file.

# Server
PORT=5007
NODE_ENV=development

# PostgreSQL (Neon)
DB_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT / Session (must match auth service SECRET_KEY)
SECRET_KEY=replace-with-a-long-random-secret

# Redis (session validation, rate-limit counters)
REDIS_URL=redis://localhost:6379

# URL of the utils service (internal; never expose to frontend)
UPLOAD_SERVICE=http://localhost:5005

# Shared secret that identifies trusted internal service calls
# Must match INTERNAL_SERVICE_KEY in the utils service
# e.g.: openssl rand -hex 32
INTERNAL_SERVICE_KEY=replace-with-shared-internal-secret

# Kafka (email delivery)
KAFKA_BROKER=localhost:9092

# Frontend origin(s) allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Phase 4: Lever ingestion — comma-separated Lever company slugs to fetch
# from Lever's official public Postings API (https://api.lever.co/v0/postings/<slug>).
# Optional display name per slug: "slug:Display Name" (Lever's public API does
# not return a company display name, so it must come from configuration).
# e.g.: LEVER_COMPANIES=palantir,some-other-company:Some Other Company
LEVER_COMPANIES=

# Phase 5: Greenhouse ingestion — comma-separated Greenhouse board tokens
# (https://boards-api.greenhouse.io/v1/boards/<token>/jobs). Optional display
# name fallback per slug ("slug:Display Name") — Greenhouse's response
# usually includes company_name already, so this is rarely needed.
# e.g.: GREENHOUSE_COMPANIES=gitlab,some-other-company:Some Other Company
GREENHOUSE_COMPANIES=

# Phase 5: Ashby ingestion — comma-separated Ashby public job-board names
# (https://api.ashbyhq.com/posting-api/job-board/<name>). Optional display
# name per slug: "slug:Display Name" (Ashby's public API does not return a
# company display name, so it must come from configuration).
# e.g.: ASHBY_COMPANIES=zapier,some-other-company:Some Other Company
ASHBY_COMPANIES=

# ---------------------------------------------------------------------------
# Phase 6: Scheduling + Ingestion Reliability
# Read/validated by services/job/src/ingestion/scheduler/config.ts. Only
# consumed by `npm run ingest:scheduler` — the API process (index.ts) never
# reads these and never starts a scheduler itself.
# ---------------------------------------------------------------------------

# Master switch for the long-running scheduler (`npm run ingest:scheduler`).
# `--once` ignores this and runs regardless, for local verification.
# Default: false.
INGESTION_SCHEDULER_ENABLED=false

# Semicolon-separated "source:cron expression" pairs (standard 5-field cron:
# minute hour day-of-month month day-of-week). Every source must already be
# registered (fixture/lever/greenhouse/ashby); "fixture" is rejected outright
# since it must never run on a schedule. Default: empty (nothing scheduled).
# e.g.: INGESTION_SCHEDULES=lever:0 * * * *;greenhouse:15 * * * *;ashby:30 * * * *
INGESTION_SCHEDULES=

# IANA timezone the cron expressions above are evaluated in. Default: UTC.
INGESTION_TIMEZONE=UTC

# Max number of sources this scheduler process runs at the same time.
# Per-source overlap (this or another process) is prevented separately by
# the DB-backed lock below, regardless of this setting. Default: 1.
INGESTION_MAX_CONCURRENCY=1

# How long (seconds) a per-source lock (`ingestion_locks` table) is held
# before it's considered abandoned and can be recovered by another attempt —
# the safety net if a scheduler process crashes or is killed mid-run.
# Default: 1800 (30 minutes).
INGESTION_LOCK_TTL_SECONDS=1800

# Bounded exponential-backoff-with-jitter retry, applied only when an entire
# source's fetch fails with a retryable error class (HTTP 429/5xx, timeouts,
# network errors) — never for permanent/configuration errors, and never for
# a "partial" run (some companies/boards already succeeded). Defaults: 3
# attempts, 1000ms base delay, 30000ms max delay.
INGESTION_RETRY_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_DELAY_MS=1000
INGESTION_RETRY_MAX_DELAY_MS=30000

# A job is deactivated (is_active=false, never deleted) only after this many
# *successful, full* ingestion runs for its source in a row failed to see it
# again — never after a failed or partial run. Default: 3.
INGESTION_STALE_AFTER_RUNS=3

# How long (ms) graceful shutdown (SIGTERM/SIGINT) waits for in-flight
# ingestion to finish before returning anyway. Default: 30000 (30s).
INGESTION_SHUTDOWN_TIMEOUT_MS=30000

# Phase 7: Advanced search (GET /api/job/external/search) introduces no new
# environment variables. It reuses DB_URL/DATABASE_URL and REDIS_URL above
# (the search rate limiter uses the same Redis store as every other
# rate limiter in this service). See docs/search.md.

# ---------------------------------------------------------------------------
# Phase 8: Job Intelligence
# Read/validated by services/job/src/intelligence/config.ts. Consumed by
# `npm run intelligence:*` and the `job-intelligence-worker` container. The
# API process (index.ts) never triggers processing itself — it only reads
# already-computed intelligence. See docs/intelligence.md.
# ---------------------------------------------------------------------------

# Master switch for AI-assisted extraction (responsibilities/requirements/
# summary, ONLY when deterministic extraction found nothing itself).
# Deterministic extraction (skills, seniority, experience, education,
# employment type, work arrangement, compensation) always runs regardless
# of this setting. Default: false (fully functional without any AI key).
INTELLIGENCE_AI_ENABLED=false

# Required when INTELLIGENCE_AI_ENABLED=true. Reuses the same provider/SDK
# already used by the utils service (Google Gemini via @google/genai) — a
# separate key because job-service is a separate deployable process, not a
# new AI architecture.
INTELLIGENCE_GEMINI_API_KEY=

# Default: gemini-3-flash-preview (same model utils-service already uses).
INTELLIGENCE_GEMINI_MODEL=gemini-3-flash-preview

# Job descriptions are untrusted input — hard cap before any processing
# (deterministic or AI). Default: 20000 characters.
INTELLIGENCE_MAX_DESCRIPTION_LENGTH=20000

# Batch/backfill page size and worker-pool concurrency. Defaults: 20 and 2.
INTELLIGENCE_BATCH_SIZE=20
INTELLIGENCE_MAX_CONCURRENCY=2

# How long (ms) to wait for one AI provider call before treating it as a
# (retryable) timeout failure. Default: 15000 (15s).
INTELLIGENCE_AI_TIMEOUT_MS=15000

# How often (ms) the intelligence worker checks for pending jobs. Default:
# 60000 (60s).
INTELLIGENCE_WORKER_INTERVAL_MS=60000
