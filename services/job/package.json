    "intelligence:process": "npx tsx src/intelligence/scripts/cli.ts",
    "intelligence:backfill": "npx tsx src/intelligence/scripts/cli.ts --all",
    "intelligence:reprocess": "npx tsx src/intelligence/scripts/cli.ts --all --force",
    "intelligence:worker": "npx tsx src/intelligence/scripts/worker.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "add-extensions": "./add-extensions.sh"
