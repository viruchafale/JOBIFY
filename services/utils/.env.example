# Utils Service Environment Variables
# Copy to .env and fill in real values. Never commit the filled .env file.

# Server
PORT=5005
NODE_ENV=development

# JWT / Session (must match auth service SECRET_KEY — used to validate session cookies)
SECRET_KEY=replace-with-a-long-random-secret

# Redis (session validation, rate-limit counters)
REDIS_URL=redis://localhost:6379

# Cloudinary credentials (for file uploads)
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Google Gemini API key (for career and resume-analyzer AI endpoints)
API_KEY_GEMINI=your-gemini-api-key

# Shared secret for trusted internal service requests (upload endpoint)
# e.g.: openssl rand -hex 32  — must match all backend services
INTERNAL_SERVICE_KEY=replace-with-shared-internal-secret

# Kafka (email consumer)
KAFKA_BROKER=localhost:9092

# Gmail SMTP credentials (email delivery)
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_PASS=your-gmail-app-password

# Frontend origin(s) allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
